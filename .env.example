# Copy to .env next to compose.yaml. .env is gitignored.
# Every RECLAIMER_DEDICATED_* variable overrides server/dedicated.toml, and a
# misspelt one stops the start rather than being ignored.

# Image. `latest` follows each release. Players' clients update themselves, and
# 0.9.1 cannot play with 0.9.0, so a pinned server falls behind its players.
# IMAGE=ghcr.io/projectreclaimer/project-reclaimer-dedicated:0.9.1

# Install each new stable release and restart. A restart ends games in
# progress, so this is a trade against players being locked out by a version
# mismatch. On by default here; turn it off for a scheduled match night.
RECLAIMER_DEDICATED_AUTO_UPDATE=true

# UDP ports, one per [[server]] in dedicated.toml. Widen this when adding one.
GAME_PORTS=49176-49178

# Remote console. 8-128 characters. Leave unset to keep RCON off.
# RECLAIMER_DEDICATED_RCON_PASSWORD=
# RECLAIMER_DEDICATED_RCON_ADDRESS=0.0.0.0

# Lobby keeper (compose.yaml): cancels the map vote on these servers while
# fewer than LOBBY_KEEPER_MIN_PLAYERS are in, and opens it once the lobby
# fills. Needs the RCON password and address above. The FFA server (49178) is
# left out, so it starts with whoever is there.
# LOBBY_KEEPER_PORTS=49176,49177
# LOBBY_KEEPER_MIN_PLAYERS=8

# The address players connect to, if detection picks the wrong one.
# RECLAIMER_DEDICATED_PUBLIC_ADDRESS=

# Extra admins, added to dedicated.toml's list. Commas or spaces.
# RECLAIMER_DEDICATED_ADMINS=

# Run the servers as this user and group (defaults to the server folder's owner).
# PUID=1000
# PGID=1000

# Game files somewhere other than server/game, e.g. a Steam install on this box.
# GAME_DIR=
