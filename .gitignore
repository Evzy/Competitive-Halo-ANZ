# Game files: copied from each host's own MCC install, never distributed.
server/game/

# Mod binaries: listed in mods.json, copied in by scripts/sync-mods.ps1.
server/content/Mods/*
!server/content/Mods/README.md

# MCC's own variants, copied in by scripts/copy-mcc-content.ps1 from the
# list in server/content/mcc-content.json.
server/content/Game Modes/h3_*.bin
server/content/Maps/mlg_*_012.mvar

# Written by the running servers.
server/data/
server/bans.json
server/.reclaimer/

# Secrets.
.env

# Never commit map or engine files, wherever they end up.
*.map
*.dll

node_modules/
